{
  "name": "creer",
  "private": true,
  "version": "2.0.0",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite --host 127.0.0.1 --port 5178 --open",
    "build:standalone": "tsc -b && vite build --config vite.single.config.ts && node scripts/package-copy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/instrument-serif": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "description": "Creer — a warm, browser-native DAW for making music.",
  "engines": {
    "node": ">=20"
  }
}
